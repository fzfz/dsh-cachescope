{
  "name": "@kober-basket/dsh-cachescope",
  "version": "0.1.2",
  "description": "Prompt-cache observability and logical-input diagnostics for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "assets/*.jpg",
    "cordis.patch.yml",
    "screenshots.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --import tsx/esm --test tests/cachescope.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "prompt-cache",
    "prefill",
    "observability",
    "llm"
  ],
  "author": "kober-basket",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kober-basket/dsh-cachescope.git"
  },
  "homepage": "https://github.com/kober-basket/dsh-cachescope#readme",
  "bugs": {
    "url": "https://github.com/kober-basket/dsh-cachescope/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.20.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
