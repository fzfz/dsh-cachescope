{
  "name": "@kober-basket/dsh-cachescope",
  "version": "0.1.2",
  "description": "Native CacheScope diagnostics plugin for DSH Desktop 0.1.1 with DSH 0.1.2-rc.1",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./client/client.js"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "assets/*.jpg",
    "cordis.patch.yml",
    "screenshots.json",
    "client/*.js",
    "docs/desktop-compatibility.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --import ./tests/register-css.mjs --import tsx/esm --test tests/*.test.ts tests/*.test.tsx",
    "typecheck": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "prompt-cache",
    "prefill",
    "observability",
    "llm"
  ],
  "author": "kober-basket",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fzfz/dsh-cachescope.git"
  },
  "homepage": "https://github.com/fzfz/dsh-cachescope#readme",
  "bugs": {
    "url": "https://github.com/fzfz/dsh-cachescope/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@types/jsdom": "28.0.3",
    "@types/node": "22.20.1",
    "jsdom": "29.1.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "esbuild": "0.25.12",
    "@deepseek-ai/dsh-util-values": "0.1.2-rc.1"
  }
}
